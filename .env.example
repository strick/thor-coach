# Thor v2 configuration — copy to .env and fill in.
# .env is gitignored. NEVER commit real keys.

PORT=3100

# --- LLM ---
# Provider used by default: "openai" or "ollama"
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Strava (https://www.strava.com/settings/api) ---
# After first successful sync the refresh token is persisted in the DB
# (app_settings) and rotated automatically.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# --- Microsoft-account sign-in (optional) ---
# When MS_CLIENT_ID and MS_CLIENT_SECRET are both set, the UI requires
# "Sign in with Microsoft" and /api/* accepts the session cookie (or the PIN,
# if that's also set). Left blank, Thor behaves exactly as before.
# App registration: Entra ID → App registrations → web redirect URI
# <base-url>/auth/callback, sign-in audience "personal Microsoft accounts".
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# consumers = personal Microsoft accounts (default); common = also work/school
MS_TENANT=consumers
# Comma-separated emails allowed to sign in; the first sign-in claims the
# existing default DB user (user-main), so your data stays yours.
THOR_ALLOWED_EMAILS=
# Public base URL for the OAuth redirect (required behind a proxy/App Service;
# blank = derived from the Host header, fine for localhost)
THOR_BASE_URL=
# Cookie-signing secret (blank = derived from MS_CLIENT_SECRET)
SESSION_SECRET=
# Session lifetime in days (default 30)
# THOR_SESSION_DAYS=30

# Optional: shared PIN required for all API calls (blank = no auth)
THOR_PIN=
# Optional: override backup mirror location (default /mnt/g/backups/thor)
# THOR_BACKUP_MIRROR=/mnt/g/backups/thor
